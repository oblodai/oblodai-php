<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <!-- unit: pure logic and the transport over a fake HTTP stack. -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- contract: every route and every recorded response body, against contract/. -->
        <testsuite name="contract">
            <directory>tests/Contract</directory>
        </testsuite>
        <!-- live: needs a running core; set OBLODAI_LIVE_URL (composer test-live). -->
        <testsuite name="live">
            <directory>tests/Live</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
