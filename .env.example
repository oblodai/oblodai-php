# Oblodai credentials. SERVER SIDE ONLY — a secret must never reach a browser or a mobile app.

# The one API key (X-Public-Id and the secret that signs every request — payments, payouts,
# settings, documents alike). A sandbox key looks like test_oblodai_... / oblodai_test_...
OBLODAI_PUBLIC_ID=oblodai_...
OBLODAI_SECRET=oblodai_live_...

# API origin. Defaults to https://api.oblodai.com; a path prefix is kept.
# OBLODAI_BASE_URL=https://api.oblodai.com

# Allow a plain http:// base URL (loopback is allowed without this).
# OBLODAI_ALLOW_INSECURE=1

# Admin token of a self-hosted gateway; only the merchant-provisioning routes use it.
# OBLODAI_ADMIN_TOKEN=...

# Console logging: debug | info | warn | error. Secrets and signatures are redacted.
# OBLODAI_LOG=warn

# The endpoint secret webhooks are signed with (webhooks->register / rotateSecret).
# OBLODAI_WEBHOOK_SECRET=<64 hex characters>
# During a rotation, keep the outgoing secret here for at least 26 hours.
# OBLODAI_WEBHOOK_SECRET_PREV=<64 hex characters>

# Live test tier (composer test-live):
# OBLODAI_LIVE_URL=http://127.0.0.1:8095
# OBLODAI_LIVE_HOOK_URL=http://127.0.0.1:8096/hook
