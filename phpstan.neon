parameters:
    level: max
    paths:
        - src
        - tests
        - examples
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Oblodai::attach() initialises the readonly resource properties exactly once — from the
        # constructor, or on the bare copy Oblodai::withOptions() makes (PHP enforces the "once").
        -
            identifier: property.readOnlyAssignNotInConstructor
            path: src/Oblodai.php
