{
    "name": "oblodai/sdk",
    "description": "Official PHP SDK for the Oblodai payment gateway: accepting payments, payouts, static wallets, webhooks. Generated from the gateway's OpenAPI contract.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "oblodai",
        "crypto",
        "payments",
        "payout",
        "cryptocurrency",
        "usdt",
        "webhook",
        "payment-gateway"
    ],
    "homepage": "https://github.com/oblodai/oblodai-php",
    "authors": [
        {
            "name": "Oblodai"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.51",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "suggest": {
        "psr/log": "To route the SDK log through Monolog or any PSR-3 logger via Oblodai\\Log\\Psr3Logger",
        "psr/http-client-implementation": "To use Oblodai\\Http\\Psr18HttpClient instead of the bundled cURL client"
    },
    "autoload": {
        "psr-4": {
            "Oblodai\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oblodai\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fmt": "php-cs-fixer fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit --testsuite unit,contract,conformance",
        "test-live": "phpunit --testsuite live"
    },
    "support": {
        "issues": "https://github.com/oblodai/oblodai-php/issues",
        "source": "https://github.com/oblodai/oblodai-php"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
